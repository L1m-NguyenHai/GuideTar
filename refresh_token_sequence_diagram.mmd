sequenceDiagram
    participant User as "👤 User"
    participant Frontend as "📱 Frontend"
    participant AuthSession as "🔐 AuthSession"
    participant Server as "🖥️ FastAPI Server"
    participant DB as "🗄️ PostgreSQL"

    Frontend->>Server: Gửi request có Bearer token
    Note over Frontend,Server: GET /api/analyze/history<br/>Authorization: Bearer access_token

    alt Token còn hạn
        Server-->>Frontend: 200 OK (dữ liệu)
        Frontend-->>User: Hiển thị dữ liệu
    else Token hết hạn
        Server-->>Frontend: 401 Unauthorized

        Frontend->>Frontend: Phát hiện 401 → refresh
        Frontend->>Server: POST /auth/refresh
        Note over Frontend,Server: {refresh_token: "..."}

        Server->>Server: decode_token(refresh_token)
        alt Refresh token hợp lệ
            Server->>DB: SELECT user + profile by user_id
            DB-->>Server: user data
            Server->>Server: create_access_token(user_id) [30 phút]
            Server->>Server: create_refresh_token(user_id) [30 ngày]
            Server-->>Frontend: 200 {access_token, refresh_token, user}

            Frontend->>AuthSession: setTokens(access, refresh, user)
            AuthSession-->>Frontend: Token mới lưu trong memory

            Frontend->>Server: Retry request gốc với token mới
            Note over Frontend,Server: Authorization: Bearer new_access_token
            Server-->>Frontend: 200 OK (dữ liệu)
            Frontend-->>User: Hiển thị dữ liệu

        else Refresh token hết hạn
            Server-->>Frontend: 401 Invalid refresh token
            Frontend->>AuthSession: clear()
            Frontend-->>User: Chuyển đến màn hình Login
        end
    end
