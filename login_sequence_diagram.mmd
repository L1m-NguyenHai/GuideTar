sequenceDiagram
    participant User as "👤 User"
    participant Frontend as "📱 Frontend"
    participant AuthSession as "🔐 AuthSession"
    participant Server as "🖥️ FastAPI Server"
    participant DB as "🗄️ PostgreSQL"

    User->>Frontend: Nhập email & password, nhấn "Đăng nhập"
    Frontend->>Server: POST /auth/login {email, password}
    Server->>DB: SELECT id, password_hash FROM users WHERE email=$1
    DB-->>Server: row?
    Server->>Server: verify_password(password, hash)
    alt Sai email hoặc mật khẩu
        Server-->>Frontend: 401 Invalid email or password
        Frontend-->>User: Dialog "Sai email hoặc mật khẩu"
    else Đăng nhập thành công
        Server->>Server: create_access_token(user_id) [30 phút]
        Server->>Server: create_refresh_token(user_id) [30 ngày]
        Server-->>Frontend: 200 {access_token, refresh_token, user}
        Frontend->>AuthSession: setTokens(access, refresh, user)
        AuthSession-->>Frontend: Lưu token in-memory
        Frontend-->>User: SnackBar "Đăng nhập thành công!" → HomePage
    end
