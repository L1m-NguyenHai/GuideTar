sequenceDiagram
    participant User as "👤 User"
    participant Frontend as "📱 Frontend"
    participant AuthSession as "🔐 AuthSession"
    participant Server as "🖥️ FastAPI Server"
    participant DB as "🗄️ PostgreSQL"

    User->>Frontend: Nhập email → Xác nhận → Password → Username
    Note over User,Frontend: Wizard 4 bước, bước cuối gọi API
    Frontend->>Server: POST /auth/register {email, password, username}
    Server->>DB: SELECT 1 FROM users WHERE email=$1
    DB-->>Server: row?
    alt Email đã tồn tại
        Server-->>Frontend: 409 Email already exists
        Frontend-->>User: Modal "Email đã được sử dụng"
    else Email chưa tồn tại
        Server->>DB: SELECT 1 FROM users WHERE username=$1
        DB-->>Server: row?
        alt Username đã tồn tại
            Server-->>Frontend: 409 Username already exists
            Frontend-->>User: Modal "Tên người dùng đã tồn tại"
        else Tạo tài khoản
            Server->>Server: hash_password(password)
            Server->>DB: INSERT INTO users (email, password_hash, username) RETURNING id
            DB-->>Server: user_id
            Server->>DB: INSERT INTO user_profiles (user_id, display_name)
            DB-->>Server: ok
            Server->>DB: SELECT user + profile by user_id
            DB-->>Server: user data
            Server->>Server: create_access_token(user_id)
            Server->>Server: create_refresh_token(user_id)
            Server-->>Frontend: 200 {access_token, refresh_token, user}
            Frontend->>AuthSession: setTokens(access, refresh, user)
            AuthSession-->>Frontend: Lưu token in-memory
            Frontend-->>User: SnackBar "Đăng ký thành công!" → HomePage
        end
    end
