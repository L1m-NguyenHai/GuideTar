sequenceDiagram
    participant User as "👤 User"
    participant Frontend as "📱 Frontend"
    participant AuthSession as "🔐 AuthSession"
    participant Server as "🖥️ FastAPI Server"
    participant DB as "🗄️ PostgreSQL"

    User->>Frontend: Mở trang Đăng ký
    Frontend->>Server: GET /billing/plans
    Server->>DB: SELECT * FROM subscription_plans WHERE is_active=true
    DB-->>Server: [Solo (99K/tháng), Maestro (199K/tháng)]
    Server-->>Frontend: 200 danh sách gói
    Frontend-->>User: Hiển thị 2 gói Solo & Maestro

    User->>Frontend: Chọn gói Maestro, nhấn "Dùng thử 2 tuần"
    Frontend->>Frontend: Hiển thị popup tính năng → chuyển trang thanh toán
    User->>Frontend: Nhập thông tin thanh toán, nhấn "Thanh toán"

    Frontend->>Server: POST /billing/pay {amount, currency, method_type}
    Note over Frontend,Server: method_type: "card" | "qr"
    Server->>DB: INSERT INTO payment_transactions (status='pending')
    DB-->>Server: transaction {id, payment_code, ...}
    Server-->>Frontend: 200 {payment_code, amount, ...}

    Frontend->>Frontend: Timer 3 giây → popup thành công
    Frontend-->>User: "Đăng ký thành công!"

    Note over User,DB: --- Sau đó: xem subscription & hủy ---

    User->>Frontend: Mở trang Membership
    Frontend->>Server: GET /billing/subscription
    Note over Frontend,Server: Authorization: Bearer token
    Server->>DB: SELECT s.*, p.* FROM user_subscriptions s JOIN plans p WHERE user_id=$1
    DB-->>Server: subscription (active/trial/canceled/null)
    Server-->>Frontend: 200 subscription info
    Frontend-->>User: Hiển thị trạng thái gói & ngày gia hạn

    User->>Frontend: Nhấn "Hủy đăng ký"
    Frontend->>Frontend: Dialog xác nhận "Xác nhận hủy gói?"
    User->>Frontend: Xác nhận hủy

    Frontend->>Server: POST /billing/subscription/cancel
    Note over Frontend,Server: Authorization: Bearer token
    Server->>DB: UPDATE user_subscriptions SET status='canceled', canceled_at=now()
    DB-->>Server: updated
    alt Không có subscription đang active
        Server-->>Frontend: 404 No active subscription found
        Frontend-->>User: Dialog "Không tìm thấy gói"
    else Hủy thành công
        Server-->>Frontend: 200 {detail: "Subscription canceled"}
        Frontend-->>User: Dialog "Xác nhận hủy thành công"
        Frontend->>Frontend: Refresh dữ liệu
    end
