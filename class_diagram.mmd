---
config:
  layout: elk
---
classDiagram
    direction TB

    %% 1. FRONTEND: VIEW LAYER
    class AppRootPage {
        +checkAuthStatus()
    }
    class LoginPage {
        +submitCredentials()
    }
    class HomePage {
        +int currentIndex
        +switchTab(index)
    }

    class GuitarToolkitPage {
        +openDechord()
        +openTuner()
        +openEarTraining()
        +openChordBook()
    }
    class PianoToolkitPage {
        +openSimulator()
        +openSheetReader()
        +openCourses()
    }
    class ProfilePage {
        +editProfile()
        +viewFavorites()
    }

    class DechordPage {
        +File audioFile
        +String youtubeUrl
        +pickFile()
        +submitToBackend()
    }
    class ProTunerPage {
        +listenToMic()
        +detectPitch()
    }
    class ChordBookPage {
        +searchSong()
        +openSong()
    }
    class CatalogSongChordPage {
        +displayChords()
        +transpose()
    }
    class GuitarEarTrainingPage {
        +startExercise()
    }
    class GuitarCoursePage {
        +loadCourses()
        +openLesson(id)
    }
    class GuitarCMajorLessonPage {
        +playVideo()
        +showInstructions()
    }

    class PianoSimLandscapePage {
        +playKey(key)
        +recordMidi()
    }
    class PianoSheetPlayerPage {
        +loadMusicXML()
        +playSheet()
    }
    class PianoBasicCoursesPage {
        +loadCourses()
        +openLesson(id)
    }
    class PianoIntroDetailPage {
        +playVideo()
        +showInstructions()
    }
    
    class MembershipPage {
        +upgradePro()
    }

    %% 2. FRONTEND: DATA LAYER
    class AuthSession {
        +String accessToken
        +String refreshToken
        +User currentUser
        +login(email, password)
        +logout()
    }
    class BackendApi {
        +String baseUrl
        +apiPostAnalyze()
        +apiGetProfile()
        +apiGetCatalog()
        +apiUpgradeMembership()
    }

    %% 3. BACKEND: SERVICES
    class AuthService {
        +authenticate_user()
        +refresh_token()
    }
    class DechordService {
        +process_audio_file()
        +call_madmom()
    }
    class EarTrainingService {
        +generate_guitar_exercise()
        +generate_piano_exercise()
    }
    class CatalogService {
        +get_artists()
        +get_songs()
        +get_chords()
    }
    class BillingService {
        +process_payment()
        +update_subscription()
    }

    %% 4. DATABASE: SCHEMAS
    class UserProfile {
        +UUID id
        +String email
        +String rank_label
        +Boolean is_pro
    }
    class AnalyzeHistory {
        +UUID id
        +String source_type
        +Int chord_count
        +DateTime created_at
    }
    class SongCatalog {
        +UUID song_id
        +String title
        +String artist_id
    }
    class Subscription {
        +UUID id
        +UUID user_id
        +String tier
        +DateTime expires_at
    }

    %% Relationships - UI Navigation
    AppRootPage --> LoginPage : Unauthenticated
    AppRootPage --> HomePage : Authenticated
    LoginPage --> HomePage : Login Success
    
    HomePage --> GuitarToolkitPage
    HomePage --> PianoToolkitPage
    HomePage --> ProfilePage

    %% Guitar Dependencies
    GuitarToolkitPage --> DechordPage
    GuitarToolkitPage --> ProTunerPage
    GuitarToolkitPage --> GuitarEarTrainingPage
    GuitarToolkitPage --> ChordBookPage
    GuitarToolkitPage --> GuitarCoursePage
    ChordBookPage --> CatalogSongChordPage
    GuitarCoursePage --> GuitarCMajorLessonPage
    
    %% Piano Dependencies
    PianoToolkitPage --> PianoSimLandscapePage
    PianoToolkitPage --> PianoSheetPlayerPage
    PianoToolkitPage --> PianoBasicCoursesPage
    PianoBasicCoursesPage --> PianoIntroDetailPage
    
    ProfilePage --> MembershipPage

    %% Relationships - Data Flow
    LoginPage --> AuthSession : authenticates
    AuthSession --> BackendApi : configures token
    
    DechordPage ..> BackendApi
    MembershipPage ..> BackendApi
    CatalogSongChordPage ..> BackendApi
    GuitarEarTrainingPage ..> BackendApi
    
    BackendApi ..> AuthService : /auth
    BackendApi ..> DechordService : /dechord
    BackendApi ..> EarTrainingService : /ear_training
    BackendApi ..> CatalogService : /catalog
    BackendApi ..> BillingService : /billing
    
    %% Relationships - DB Interaction
    AuthService --> UserProfile
    DechordService --> AnalyzeHistory
    CatalogService --> SongCatalog
    BillingService --> Subscription
    EarTrainingService --> UserProfile