graph TB
    %% ─── STYLING ───
    classDef client fill:#1a1a2e,stroke:#16213e,color:#fff
    classDef network fill:#0f3460,stroke:#533483,color:#fff
    classDef server fill:#533483,stroke:#e94560,color:#fff
    classDef service fill:#e94560,stroke:#0f3460,color:#fff
    classDef db fill:#16213e,stroke:#1a1a2e,color:#fff
    classDef external fill:#2d2d2d,stroke:#555,color:#fff

    %% ─── CLIENT LAYER ───
    subgraph Client["📱 Client Layer — Flutter (Dart)"]
        direction TB
        UI["UI Pages<br/>Login, Register, Home,<br/>Guitar Toolkit, Piano Toolkit,<br/>Membership, Profile"]

        State["Client State<br/>AuthSession<br/>accessToken, refreshToken"]
        API["API Client<br/>BackendApi<br/>_request(), _decodeMap()"]

        UI --> State
        State --> API
    end

    %% ─── NETWORK ───
    subgraph Network["🌐 Network"]
        HTTP("HTTP / HTTPS<br/>REST API (JSON)")
    end

    API --> HTTP

    %% ─── SERVER LAYER ───
    subgraph Server["🖥️ Server Layer — Python FastAPI (Uvicorn)"]
        direction TB
        Auth["Auth Routes<br/>/auth/register, /auth/login<br/>/auth/refresh, /auth/forgot-password"]

        Billing["Billing Routes<br/>/billing/plans, /billing/subscription<br/>/billing/subscription/cancel, /billing/pay"]

        Dechord["DeChord Routes<br/>POST /api/analyze<br/>GET /api/analyze/history<br/>GET /api/analyze/history/{id}"]

        Catalog["Catalog Routes<br/>/catalog/recommended<br/>/catalog/artists</br>/artists/{name}/follow"]

        Favorites["Favorites Routes<br/>/favorites/songs<br/>/favorites/lessons"]

        Support["Support Routes<br/>/support/categories<br/>/support/faqs<br/>/support/conversations"]

        Users["User Routes<br/>/users/me"]

        Analytics["Analytics Routes<br/>/analytics/weekly"]

        Router["API Router v1"]
        Router --> Auth
        Router --> Billing
        Router --> Dechord
        Router --> Catalog
        Router --> Favorites
        Router --> Support
        Router --> Users
        Router --> Analytics

        Services["Services Layer"]
        DechordService["DechordService<br/>detect_beats_madmom()<br/>run_chord_cnn_lstm()<br/>build_analysis_result()"]

        EarTrainingService["EarTrainingService<br/>generate_guitar_exercise()<br/>generate_piano_exercise()"]

        Security["Security<br/>JWT encode/decode<br/>Password hashing"]

        Auth --> Security
        Dechord --> DechordService
    end

    HTTP --> Router

    %% ─── DATABASE LAYER ───
    subgraph Database["🗄️ Database Layer — PostgreSQL (Supabase)"]
        direction TB
        UsersDB[("users<br/>user_profiles")]
        DechordDB[("dechord_analyses<br/>dechord_analysis_beats")]
        CatalogDB[("hac_songs<br/>hac_artists<br/>hac_song_versions")]
        FavoritesDB[("favorite_songs<br/>favorite_lessons")]
        BillingDB[("subscription_plans<br/>user_subscriptions<br/>payment_transactions<br/>payment_methods")]
        SupportDB[("support_categories<br/>support_faqs<br/>support_conversations")]
        AnalyticsDB[("practice_daily_stats")]
    end

    DechordService --> DechordDB
    Security --> UsersDB
    Billing --> BillingDB
    Catalog --> CatalogDB
    Favorites --> FavoritesDB
    Support --> SupportDB
    Analytics --> AnalyticsDB

    %% ─── EXTERNAL SERVICES ───
    subgraph External["🌍 External Services"]
        YT[("YouTube<br/>yt-dlp + FFmpeg")]
        ChordModel[("Chord-CNN-LSTM<br/>Model Inference")]
        Madmom[("madmom<br/>Beat Detection")]
        HAC[("HopAmChuan<br/>Chord Crawler")]
    end

    DechordService --> YT
    DechordService --> ChordModel
    DechordService --> Madmom
    HAC -.->|Import Data| CatalogDB
